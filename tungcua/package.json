{
  "name": "tungcua",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:accuracy": "jest --testPathPatterns=accuracy",
    "test:e2e:android": "maestro test e2e/maestro",
    "test:e2e:ios": "maestro test e2e/maestro",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:dictionary": "tsx scripts/build-dictionary.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "spike:a:build:android": "cd spikes/spike-a && pnpm eas build --platform android --profile development",
    "spike:a:build:ios": "cd spikes/spike-a && pnpm eas build --platform ios --profile development",
    "spike:b:build:android": "cd spikes/spike-b && pnpm eas build --platform android --profile development",
    "spike:b:build:ios": "cd spikes/spike-b && pnpm eas build --platform ios --profile development",
    "spike:a:run": "cd spikes/spike-a && pnpm expo start --dev-client",
    "spike:b:run": "cd spikes/spike-b && pnpm expo start --dev-client",
    "spike:clean": "rm -rf spikes/spike-a/node_modules spikes/spike-b/node_modules spikes/spike-a/.expo spikes/spike-b/.expo spikes/spike-a/dist spikes/spike-b/dist",
    "spike:verify-network": "tsx scripts/verify-no-network.ts",
    "spike:audit": "tsx scripts/audit-package-json.ts"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.1.0",
    "opencc-js": "^1.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.3"
  }
}